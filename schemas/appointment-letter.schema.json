{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "employeeId",
    "candidateName",
    "designation",
    "department",
    "dateOfJoining",
    "workLocation",
    "annualCtc",
    "probationMonths",
    "noticePeriodDays",
    "reportingManager",
    "letterDate"
  ],
  "properties": {
    "employeeId": { "type": "string", "minLength": 1 },
    "candidateName": { "type": "string", "minLength": 1 },
    "designation": { "type": "string", "minLength": 1 },
    "department": { "type": "string", "minLength": 1 },
    "dateOfJoining": { "type": "string", "format": "date" },
    "workLocation": { "type": "string", "minLength": 1 },
    "annualCtc": { "type": "number", "exclusiveMinimum": 0 },
    "probationMonths": { "type": "number", "minimum": 0 },
    "noticePeriodDays": { "type": "number", "minimum": 0 },
    "reportingManager": { "type": "string", "minLength": 1 },
    "letterDate": { "type": "string", "format": "date" }
  }
}
