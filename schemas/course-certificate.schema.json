{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "recipientName",
    "title",
    "awardDate",
    "certificateId"
  ],
  "properties": {
    "recipientName": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string"
    },
    "awardDate": {
      "type": "string",
      "format": "date"
    },
    "certificateId": {
      "type": "string",
      "minLength": 1
    },
    "trainerName": {
      "type": "string"
    },
    "trainerTitle": {
      "type": "string"
    }
  }
}
